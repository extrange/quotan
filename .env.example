# ---------------------------------------------------------------------------
# Quotan configuration
# ---------------------------------------------------------------------------
# Generate secrets with:
#   npm run auth:hash
#   npm run api:key
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# In Docker, /data is the persisted volume. For local development use
# ./data/quotan.sqlite instead.
DATABASE_PATH=/data/quotan.sqlite
APP_TIMEZONE=Asia/Singapore
TZ=Asia/Singapore

# Public URL used for cookies and CSRF checks. Set this to the Traefik host.
PUBLIC_ORIGIN=https://quotes.example.com
TRUST_PROXY=true
COOKIE_SECURE=true
LOG_LEVEL=info
# Per-IP request budget; raise for heavy automated tests.
RATE_LIMIT_MAX=300
# Failed/attempted logins per minute per IP.
LOGIN_RATE_LIMIT_MAX=5

# --- Authentication --------------------------------------------------------
# Paste the output of `npm run auth:hash`.
AUTH_PASSWORD_HASH=
# For local development only, you can use AUTH_PASSWORD=quotan instead.
# AUTH_PASSWORD=quotan

# Paste the output of `npm run api:key`.
API_KEY=

SESSION_TTL_DAYS=30
AUTH_LABEL=Private quote library

# --- Embeddings ------------------------------------------------------------
# local = in-process Transformers.js (downloads the Hugging Face model once),
# mock = deterministic test vectors, none = keyword search only.
EMBEDDING_PROVIDER=local
# Granite small English R2: 47M params, 384 dimensions, 8192-token context,
# CLS pooling. Use the ONNX Community repo with Transformers.js.
EMBEDDING_MODEL=onnx-community/granite-embedding-small-english-r2-ONNX
EMBEDDING_DIMENSIONS=384
EMBEDDING_POOLING=cls
# q8 is a good CPU default; fp32 is more accurate but larger/slower.
EMBEDDING_DTYPE=q8
# Defaults to `<database directory>/models` (/data/models in Docker).
# EMBEDDING_CACHE_DIR=/data/models
# Set to false for offline runs after the model has been cached/downloaded.
EMBEDDING_ALLOW_REMOTE=true
EMBEDDING_BATCH_SIZE=16
# Character cap applied before tokenization. Inputs over 8000 chars are embedded
# individually so a long quote cannot pad a whole batch.
EMBEDDING_MAX_CHARS=16000
# Optional prefixes for models such as Nomic or E5.
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=
AUTO_REINDEX=true
EMBEDDING_RETRY_INTERVAL_MS=60000

# Optional: token for gated/private Hugging Face model repositories.
# HF_TOKEN=

# Other CPU-friendly options (change dimensions and pooling together):
# Xenova/bge-small-en-v1.5      384 dims, EMBEDDING_POOLING=cls, 512-token context
# Xenova/all-MiniLM-L6-v2       384 dims, EMBEDDING_POOLING=mean, 512-token context
# Xenova/bge-base-en-v1.5       768 dims, EMBEDDING_POOLING=cls, 512-token context

# --- Search ----------------------------------------------------------------
SEARCH_RRF_K=60
SEARCH_KEYWORD_WEIGHT=1.0
SEARCH_VECTOR_WEIGHT=1.0
SEARCH_VECTOR_CANDIDATES=100
SEARCH_EXACT_BOOST=0.02
SEARCH_MIN_SIMILARITY=0.2

DUPLICATE_SIMILAR_THRESHOLD=0.82
DUPLICATE_LIKELY_THRESHOLD=0.95
DUPLICATE_TRIGRAM_THRESHOLD=0.85
# Near pairs merge into a cluster when the semantic score clears the first value
# and every cross pair in the merged set agrees; the trigram value is the fallback
# for quotes without vectors. Weaker matches stay as one review pair per quote.
DUPLICATE_CLUSTER_SIMILARITY=0.9
DUPLICATE_CLUSTER_TRIGRAM=0.98

# --- Import ----------------------------------------------------------------
IMPORT_MAX_ROWS=20000
IMPORT_BODY_LIMIT_MB=25

# --- Daily rotation --------------------------------------------------------
DAILY_COHORT_FRACTION=0.25
DAILY_MIN_COHORT=5

# --- Telegram daily delivery ----------------------------------------------
# Create a bot with @BotFather, then start a chat with it and put the numeric
# chat id here. Quotan sends one Starred and one Inbox quote per day. Telegram
# is outbound only: no replies, webhooks, commands, or inline buttons.
# Leave both credentials empty to disable sending; Today then offers a manual
# "Record as sent" action. Set TELEGRAM_ENABLED=false to keep credentials but
# turn sending off.
# TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Local time in APP_TIMEZONE (HH:MM, 24-hour).
DAILY_SEND_TIME=09:00
# Retry a failed send after this many seconds; check every N seconds.
DAILY_SEND_RETRY_SECONDS=300
DAILY_CHECK_INTERVAL_SECONDS=30
# Override only for tests or a local Telegram Bot API server.
# TELEGRAM_API_BASE=https://api.telegram.org

# Optional browser CORS allowlist; leave empty for same-origin only.
CORS_ORIGINS=
DOCS_ENABLED=true
